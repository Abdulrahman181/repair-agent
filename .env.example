# Copy to .env and fill in. Never commit .env.
# Groq model ids change over time; check https://console.groq.com/docs/models and
# confirm the model supports tool use before running an evaluation.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=replace-with-your-key

# Local alternative through Ollama (weak tool calling on small models, use for smoke tests):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
